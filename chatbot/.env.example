# RASA Configuration
RASA_PORT=5005
ACTION_ENDPOINT_PORT=5055

# Backend API
BACKEND_API_URL=http://localhost:5000
BACKEND_API_KEY=your_api_key_here

# RAG evaluation (LLM)
RAG_ANSWER_PROVIDER=openai
RAG_ANSWER_MODEL=gpt-4o-mini
DEEPEVAL_MODEL=gpt-4o-mini

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API (optional)
# To use DeepSeek for RAG + DeepEval:
# RAG_ANSWER_PROVIDER=deepseek
# RAG_ANSWER_MODEL=deepseek-chat
# DEEPEVAL_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Legacy aliases used by older scripts (optional)
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here

# Language
DEFAULT_LANGUAGE=vi
