# RASA Configuration
RASA_PORT=5005
ACTION_ENDPOINT_PORT=5055

# Backend API
BACKEND_API_URL=http://localhost:5000
BACKEND_API_KEY=your_api_key_here

# RAG answer generation (runtime + DeepEval)
# Provider được dùng cho cả action_rag_food_reviews (runtime) lẫn eval DeepEval.
RAG_ANSWER_PROVIDER=deepseek
RAG_ANSWER_MODEL=deepseek-chat
DEEPEVAL_MODEL=deepseek-chat
# Ngôn ngữ trả lời mặc định (điền vào system prompt)
RAG_ANSWER_LANGUAGE=tiếng Việt
# Timeout (giây) khi gọi LLM; vượt quá thì action trả về fallback (chỉ card, không text)
RAG_ANSWER_TIMEOUT=20
# Số cặp hội thoại lịch sử đưa vào prompt (0 = tắt)
RAG_ANSWER_HISTORY_TURNS=3
# Số chunk top-k đưa vào prompt làm Retrieved context
RAG_ANSWER_CONTEXT_CHUNKS=5

# OpenAI API (fallback provider)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API (fallback provider)
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API (provider mặc định cho RAG + DeepEval)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Apify API (optional, used to enrich Facebook posts with comments)
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_FACEBOOK_COMMENTS_ACTOR=apify/facebook-comments-scraper

# Legacy aliases used by older scripts (optional)
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here

# Language
DEFAULT_LANGUAGE=vi

