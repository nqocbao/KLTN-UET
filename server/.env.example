# ===================================
# KLTN TRAVEL PLATFORM - Backend Config
# ===================================

# === DATABASE ===
# MongoDB Connection
# For local MongoDB: mongodb://localhost:27017/your_database_name
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGO_URI=mongodb://localhost:27017/kltn_travel

# === SERVER ===
PORT=5000
NODE_ENV=development

# === JWT AUTHENTICATION ===
# JWT Secret (generate a secure random string)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# === RASA CHATBOT ===
# RASA Server URL (REST API)
RASA_SERVER_URL=http://localhost:5005

# RASA Actions Server URL
RASA_ACTIONS_URL=http://localhost:5055

# === CORS ===
# Frontend URL
CORS_ORIGIN=http://localhost:3000

# === EXTERNAL APIs (Optional) ===
# Add your API keys here
# GOOGLE_MAPS_API_KEY=
# PAYMENT_GATEWAY_KEY=
# EMAIL_SERVICE_KEY=
