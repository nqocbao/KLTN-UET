@startuml rag_index_sequence
title Xây dựng chỉ mục RAG cho food review

hide footbox
autonumber
skinparam dpi 180
skinparam maxMessageSize 80
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center
skinparam roundCorner 8
skinparam ParticipantPadding 12
skinparam BoxPadding 8
skinparam shadowing false
skinparam sequence {
    ArrowColor #2C3E50
    LifeLineBorderColor #2C3E50
    LifeLineBackgroundColor #F7F9FA
    ParticipantBorderColor #2C3E50
    ParticipantBackgroundColor #16A085
    ParticipantFontColor white
    ParticipantFontStyle bold
}

participant "RAG Service\nFoodReviewRagService" as RAG
participant "Backend API\nExpress" as BE
database "MongoDB\nfood_reviews" as Mongo
participant "Chunking\nbuild_documents()" as Chunk
participant "Embedding\nSentenceTransformer" as Embed
database "ChromaDB\nfood_reviews" as Chroma

RAG -> RAG: _ensure_index()

alt Chưa có collection hoặc cần rebuild
    RAG -> BE: GET /api/client/food-reviews\npage, limit=50, sortBy=hot
    BE -> Mongo: Query food_reviews\nkèm phân trang và sắp xếp
    Mongo --> BE: Danh sách reviews
    BE --> RAG: JSON {data, pagination}

    loop Với từng review
        RAG -> Chunk: build_documents(review)
        Chunk --> RAG: title_summary chunk\nvà content chunks
    end

    loop Theo batch chunks
        RAG -> Embed: encode passages\nnormalize_embeddings=true
        Embed --> RAG: embeddings
        RAG -> Chroma: add(ids, documents,\nmetadatas, embeddings)
        Chroma --> RAG: ack
    end

    RAG -> RAG: Ghi food_reviews.meta.json\nbuilt_at, model, chunk config
else Chỉ mục còn hợp lệ
    RAG -> RAG: Dùng lại ChromaDB hiện có
end

@enduml
